{
  "openapi": "3.0.0",
  "info": {
    "title": "API - Catálogo de filmes.",
    "version": "1.0.0",
    "description": "Documentação interativa da API REST para integração com o Front-end React"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "paths": {
    "/filmes": {
      "get": {
        "summary": "Listar todos os filmes",
        "tags": ["Filmes"],
        "responses": {
          "200": {
            "description": "Lista de filmes retornada com sucesso"
          }
        }
      },
      "post": {
        "summary": "Cadastrar novo filme",
        "tags": ["Filmes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFilmeDTO"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Filme criado com sucesso" },
          "400": { "description": "Dados invalidos ou campos ausentes" },
          "409": { "description": "Titulo ja cadastrado no sistema" }
        }
      }
    },
    "/filmes/{id}": {
      "get": {
        "summary": "Buscar filme por ID",
        "tags": ["Filmes"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Filme encontrado" },
          "400": { "description": "ID informado invalido" },
          "404": { "description": "Filme nao encontrado" }
        }
      },
      "put": {
        "summary": "Atualizar dados de um filme",
        "tags": ["Filmes"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFilmeDTO"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Filme atualizado com sucesso" },
          "400": { "description": "Dados invalidos ou ID incorreto" },
          "404": { "description": "Filme nao encontrado" },
          "409": { "description": "Titulo ja esta em uso por outro filme" }
        }
      },
      "delete": {
        "summary": "Remover filme por ID",
        "tags": ["Filmes"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": { "description": "Filme removido com sucesso" },
          "400": { "description": "ID informado invalido" },
          "404": { "description": "Filme nao encontrado" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Filme": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "titulo": { "type": "string", "example": "Interestelar" },
          "genero": { "type": "string", "example": "Ficcao Cientifica" },
          "ano_lancamento": { "type": "integer", "example": 2014 },
          "nota": { "type": "number", "format": "float", "example": 8.7 },
          "disponibilidade_plataforma": { "type": "boolean", "example": true },
          "createdAt": { "type": "string", "example": "2026-09-13T10:00:00.000Z" }
        }
      },
      "CreateFilmeDTO": {
        "type": "object",
        "required": ["titulo", "genero", "ano_lancamento", "nota"],
        "properties": {
          "titulo": { "type": "string", "example": "Interestelar" },
          "genero": { "type": "string", "example": "Ficcao Cientifica" },
          "ano_lancamento": { "type": "integer", "example": 2014 },
          "nota": { "type": "number", "format": "float", "example": 8.7 },
          "disponibilidade_plataforma": { "type": "boolean", "example": true }
        }
      },
      "UpdateFilmeDTO": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string", "example": "Interestelar (versão estendida)" },
          "genero": { "type": "string", "example": "Ficcao Cientifica / Drama" },
          "ano_lancamento": { "type": "integer", "example": 2014 },
          "nota": { "type": "number", "format": "float", "example": 10.0 },
          "disponibilidade_plataforma": { "type": "boolean", "example": false }
        }
      }
    }
  }
}